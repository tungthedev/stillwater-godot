; Throwaway engine test for Stillwater: terrain, grass, trees, water, sky on the Compatibility renderer (the one Web exports use).
config_version=5

[application]
config/name="Stillwater Godot Spike"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
